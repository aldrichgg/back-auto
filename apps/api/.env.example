# =============================================================
# AutoEquity Apex Capital — API Environment Variables
# Copie para .env e preencha com os valores reais
# NUNCA commite o arquivo .env no git
# =============================================================

# ─── App ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3001,http://localhost:19006

# ─── Database (PostgreSQL) ────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=apex_user
DB_PASS=apex_password_dev
DB_NAME=autoequity_dev
DB_SYNC=false
DB_LOGGING=true

# ─── Redis ────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── JWT ──────────────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=TROQUE_POR_UMA_CHAVE_SECRETA_FORTE_DE_64_BYTES
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=TROQUE_POR_OUTRA_CHAVE_SECRETA_FORTE_DE_64_BYTES
JWT_REFRESH_EXPIRES_IN=30d

# ─── Bcrypt ───────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ─── AWS S3 (Documentos KYC, Fotos de Ativos) ────────────────
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_KYC=apex-kyc-documents
S3_BUCKET_ASSETS=apex-asset-photos

# ─── SendGrid (E-mail Transacional) ──────────────────────────
SENDGRID_API_KEY=
EMAIL_FROM=noreply@apexcapital.com.br
EMAIL_FROM_NAME=Apex Capital

# ─── Twilio (SMS / OTP) ───────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+5511000000000

# ─── Firebase (Push Notifications) ───────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── Celcoin (PIX) ────────────────────────────────────────────
CELCOIN_CLIENT_ID=
CELCOIN_CLIENT_SECRET=
CELCOIN_BASE_URL=https://sandbox.openfinance.celcoin.dev
CELCOIN_WEBHOOK_SECRET=

# ─── Rate Limiting ────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
THROTTLE_AUTH_LIMIT=10

# ─── Swagger ──────────────────────────────────────────────────
SWAGGER_ENABLED=true
SWAGGER_USER=apex_docs
SWAGGER_PASS=docs_password_dev
